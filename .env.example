# Your own API keys. NONE are shipped with the repository: each key is tied to the account and quota of whoever
# created it, so every user must supply their own.
#
# Easiest: run the interactive setup, which asks for each key, explains what it unlocks, hides what you type
# and writes this file for you as .env (git-ignored):
#
#     cd backend && python -m app.cli setup
#
# `serve` and `run` refuse to start until setup has been completed once on the machine.
# To fill .env by hand instead, copy this file to .env, set the values, and add CTIOPS_SETUP_COMPLETE=1.

# --- Recommended -----------------------------------------------------------------------------------------
# Your name, printed as reporter on client and brand reports.
CTIOPS_REPORT_REPORTER=

# urlscan.io API key (free account): higher search quotas, and scan DOMs downloaded instead of visiting
# phishing pages directly. https://urlscan.io/user/signup -> Settings & API
CTIOPS_URLSCAN_API_KEY=

# Contact User-Agent for Wikidata and SEC EDGAR (both refuse anonymous clients). Victim revenue, employees
# and industry come from these. Example: ctiops-research/0.1 (you@example.org)
CTIOPS_REGISTRY_USER_AGENT=

# --- Optional ----------------------------------------------------------------------------------------------
# Shodan: which exposed host runs a product named in an access-broker post (victim identification).
# https://account.shodan.io  (search filters need a paid membership)
CTIOPS_SHODAN_API_KEY=

# X (Twitter) API bearer token, Basic tier or higher: scheduled X access-broker monitoring.
# Without it, posts can still be captured by hand in a browser and imported (cli x-import).
CTIOPS_X_BEARER_TOKEN=

# ZoomInfo Enrich/Search API (enterprise contract only). Free public registries are used otherwise.
CTIOPS_ZOOMINFO_USERNAME=
CTIOPS_ZOOMINFO_PASSWORD=

# Anthropic API key: LLM upgrades for sector classification, IAB extraction and briefing prose.
CTIOPS_ANTHROPIC_API_KEY=
# CTIOPS_ANTHROPIC_MODEL=claude-sonnet-5-5

# Where the SQLite DB, HTTP cache and captured artifacts live (default: ./data)
# CTIOPS_DATA_DIR=./data

# Written by `cli setup`. Only for automated tests: CTIOPS_SKIP_SETUP=1 bypasses the start-up check.
# CTIOPS_SETUP_COMPLETE=1
