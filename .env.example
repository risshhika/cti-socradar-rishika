# Copy to .env (repo root). Everything is optional: the platform runs fully on public, unauthenticated sources.

# urlscan.io API key: unlocks result/DOM download instead of visiting phishing pages directly, and higher search quotas.
# CTIOPS_URLSCAN_API_KEY=

# Anthropic API key: upgrades victim sector classification, IAB extraction and briefing prose. Prompts are logged to data/artifacts/prompts.jsonl.
# CTIOPS_ANTHROPIC_API_KEY=
# CTIOPS_ANTHROPIC_MODEL=claude-sonnet-5-5

# Where the SQLite DB, HTTP cache and captured artifacts live (default: ./data)
# CTIOPS_DATA_DIR=./data
